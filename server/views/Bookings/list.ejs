<h1>Bookings</h1>
<a href="/bookings/add">Add Booking</a>
<table>
  <thead>
    <tr>
      <th>Customer</th>
      <th>Package</th>
      <th>Date</th>
    </tr>
  </thead>
  <tbody>
    <% bookingList.forEach(function(b) { %>
      <tr>
        <td>
          <%= b.customerName %> (<%= b.customerPhone %>)
        </td>
        <td>
          <%= b.servicePackage || '—' %>
        </td>
        <td>
          <%= b.bookingDate ? new Date(b.bookingDate).toLocaleString() : '—' %>
        </td>
        <td>
          <%= b.status %>
        </td>
        <td>
          <a href="/bookings/edit/<%= b._id %>">Edit</a>


          <!-- <a href="/bookings/delete/<%= b._id %>" onclick="return confirm('Delete this booking?')">Delete</a> -->
        </td>


      </tr>
      <% }) %>
  </tbody>
</table>